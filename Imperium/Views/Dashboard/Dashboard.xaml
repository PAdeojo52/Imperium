<UserControl x:Class="Imperium.Views.Dashboard.Dashboard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1500"
             Background="#1A1A2E">

    <UserControl.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#16213E"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="6"/>
        </Style>
        <Style x:Key="StatValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#4FC3F7"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="StatLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#667788"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style x:Key="ChecklistSubTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#556677"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style x:Key="LinkTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#4FC3F7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="TextDecorations" Value="Underline"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SmallActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#4FC3F7"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#4FC3F7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1A3A5A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
        <StackPanel>

            <!-- ROW 1: Player Overview Card -->
            <Border Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="60" Height="60" CornerRadius="30" Background="#2E4057" Margin="0,0,16,0">
                            <iconPacks:PackIconMaterial Kind="AccountCircle" Width="32" Height="32" 
                                                        Foreground="#667788" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="PlayerNameText" Text="Gladiator Name"
                                       FontSize="24" FontWeight="Bold" Foreground="White"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock x:Name="PlayerClassText" Text="Warrior" FontSize="13" Foreground="#FFD700"/>
                                <TextBlock Text="  |  " Foreground="#334455"/>
                                <TextBlock x:Name="PlayerLevelText" Text="Level 1" FontSize="13" Foreground="#AABBCC"/>
                                <TextBlock Text="  |  " Foreground="#334455"/>
                                <TextBlock x:Name="PlayerRecordText" Text="0-0 (0-0)" FontSize="13" Foreground="#AABBCC"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="Prestige:" FontSize="12" Foreground="#667788" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="PrestigeValueText" Text="0" FontSize="20" FontWeight="Bold" Foreground="#FFD700"/>
                            <iconPacks:PackIconMaterial Kind="Star" Width="14" Height="14" Foreground="#FFD700" Margin="4,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                            <TextBlock Text="Age:" FontSize="12" Foreground="#667788" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="PlayerAgeText" Text="18" FontSize="16" FontWeight="SemiBold" Foreground="#AABBCC"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ROW 2: Core Stats Bar -->
            <Border Style="{StaticResource CardStyle}">
                <UniformGrid Columns="7">
                    <StackPanel>
                        <TextBlock Style="{StaticResource StatValueStyle}" x:Name="StatSTR" Text="--"/>
                        <TextBlock Style="{StaticResource StatLabelStyle}" Text="STRENGTH"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Style="{StaticResource StatValueStyle}" x:Name="StatAGI" Text="--"/>
                        <TextBlock Style="{StaticResource StatLabelStyle}" Text="AGILITY"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Style="{StaticResource StatValueStyle}" x:Name="StatEND" Text="--"/>
                        <TextBlock Style="{StaticResource StatLabelStyle}" Text="ENDURANCE"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Style="{StaticResource StatValueStyle}" x:Name="StatINT" Text="--"/>
                        <TextBlock Style="{StaticResource StatLabelStyle}" Text="INTELLIGENCE"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Style="{StaticResource StatValueStyle}" x:Name="StatWIS" Text="--"/>
                        <TextBlock Style="{StaticResource StatLabelStyle}" Text="WISDOM"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Style="{StaticResource StatValueStyle}" x:Name="StatCHA" Text="--"/>
                        <TextBlock Style="{StaticResource StatLabelStyle}" Text="CHARISMA"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Style="{StaticResource StatValueStyle}" x:Name="StatLCK" Text="--"/>
                        <TextBlock Style="{StaticResource StatLabelStyle}" Text="LUCK"/>
                    </StackPanel>
                </UniformGrid>
            </Border>

            <!-- ROW 3: Three-column layout -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Last Fight -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="LAST FIGHT" FontSize="12" FontWeight="SemiBold" Foreground="#667788" Margin="0,0,0,12"/>
                        <TextBlock x:Name="LastFightText" Text="No fights yet"
                                   FontSize="18" Foreground="#556677" HorizontalAlignment="Center" Margin="0,20"/>
                    </StackPanel>
                </Border>

                <!-- Turn Checklist -->
                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="TURN CHECKLIST" FontSize="12" FontWeight="SemiBold" Foreground="#667788" Margin="0,0,0,12"/>
                        <Border BorderBrush="#2A2A4A" BorderThickness="0,0,0,1" Padding="0,8" Margin="0,0,0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <iconPacks:PackIconMaterial Kind="Sword" Width="16" Height="16" Foreground="#4FC3F7" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Train" Style="{StaticResource LinkTextStyle}"/>
                                    <TextBlock Text="Practice combat skills" Style="{StaticResource ChecklistSubTextStyle}"/>
                                </StackPanel>
                                <CheckBox Grid.Column="2" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <Border BorderBrush="#2A2A4A" BorderThickness="0,0,0,1" Padding="0,8" Margin="0,0,0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <iconPacks:PackIconMaterial Kind="Flask" Width="16" Height="16" Foreground="#4FC3F7" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Check Inventory" Style="{StaticResource LinkTextStyle}"/>
                                    <TextBlock Text="Review potions and equipment" Style="{StaticResource ChecklistSubTextStyle}"/>
                                </StackPanel>
                                <CheckBox Grid.Column="2" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <Border Padding="0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <iconPacks:PackIconMaterial Kind="ShieldStar" Width="16" Height="16" Foreground="#4FC3F7" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Review Skills" Style="{StaticResource LinkTextStyle}"/>
                                    <TextBlock Text="Allocate skill points if available" Style="{StaticResource ChecklistSubTextStyle}"/>
                                </StackPanel>
                                <CheckBox Grid.Column="2" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Next Match -->
                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="NEXT MATCH" FontSize="12" FontWeight="SemiBold" Foreground="#667788" Margin="0,0,0,12"/>
                        <Border Background="#1E3A5F" CornerRadius="6" Padding="12">
                            <StackPanel>
                                <TextBlock x:Name="NextMatchTitle" Text="No match scheduled"
                                           FontSize="13" Foreground="#AABBCC" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock x:Name="NextMatchDetails" Text="" FontSize="11" Foreground="#556677" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ROW 4: Bottom two-column -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Patron Status -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="PATRON STATUS" FontSize="12" FontWeight="SemiBold" Foreground="#667788" Margin="0,0,0,12"/>
                        <TextBlock x:Name="PatronStatusText" Text="No patron yet. Win arena matches to attract attention."
                                   FontSize="13" Foreground="#556677" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Injury Report -->
                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="STATUS &amp; INJURIES" FontSize="12" FontWeight="SemiBold" Foreground="#667788" Margin="0,0,0,12"/>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Heart" Width="16" Height="16" Foreground="#4CAF50" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="InjuryStatusText" Text="No injuries. Ready to fight."
                                       FontSize="13" Foreground="#4CAF50" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ======================================================== -->
            <!-- DEV TOOLS — REMOVE BEFORE RELEASE -->
            <!-- ======================================================== -->
            <Border Style="{StaticResource CardStyle}" BorderBrush="#E53935" BorderThickness="1">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <iconPacks:PackIconMaterial Kind="Bug" Width="16" Height="16" Foreground="#E53935" 
                                                    VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="DEV TOOLS — TESTING ONLY" FontSize="12" FontWeight="Bold" Foreground="#E53935"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="TestArenaButton" Click="TestArenaMatch_Click" Margin="0,0,8,0"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="#2E7D32" CornerRadius="6" Padding="16,8">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="Sword" Width="16" Height="16" 
                                                                        Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Test Arena Match" FontSize="13" FontWeight="SemiBold" 
                                                       Foreground="White" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#388E3C"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button x:Name="TestBattleButton" Click="TestBattle_Click"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="#C62828" CornerRadius="6" Padding="16,8">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="Skull" Width="16" Height="16" 
                                                                        Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Test Battle" FontSize="13" FontWeight="SemiBold" 
                                                       Foreground="White" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#D32F2F"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
